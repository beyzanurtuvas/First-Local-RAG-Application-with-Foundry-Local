# Yalnızca üç izin verilen DOCX'in bulunduğu klasör
LLC_SOURCE_DIR=C:\Users\KULLANICI\Desktop\Building Your First Local RAG Application with Foundry Local

# Alternatif: üç tam yolu noktalı virgülle verin (tam olarak izin verilen dosya adları)
# LLC_SOURCE_DOCS=C:\...\One-Month Machine Learning Plan.docx;C:\...\Python Pandas Titanic Project Plan.docx;C:\...\Quantum Programming Month Plan.docx

LLC_DATA_DIR=data
LLC_DB_PATH=data\app.db
LLC_INDEX_DIR=data\index
LLC_EMBEDDING_BACKEND=fastembed
LLC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLC_CHUNK_MAX_CHARS=2400
LLC_CHUNK_OVERLAP_PARAGRAPHS=1

# Güvenlik denetimi bu endpoint'in yalnızca localhost olmasına izin verir.
LLC_FOUNDRY_ENDPOINT=http://127.0.0.1:5272/v1
LLC_FOUNDRY_MODEL=
LLC_FOUNDRY_TEMPERATURE=0.0
LLC_FOUNDRY_TIMEOUT_SECONDS=30
LLC_MAX_CONTEXT_CHARS=12000

# Varsayılan mevcut yerel dense + BM25 + RRF backend'idir.
LLC_SEARCH_BACKEND=local
LLC_OPENSEARCH_ENDPOINT=http://127.0.0.1:9200
LLC_OPENSEARCH_INDEX=local-learning-coach

# İsteğe bağlı yapılandırılmış JSON web arama sağlayıcısı. Boşsa manuel URL fallback'i kullanılır.
LLC_WEB_SEARCH_ENDPOINT=
LLC_WEB_SEARCH_API_KEY=
LLC_WEB_TIMEOUT_SECONDS=12
LLC_WEB_MAX_BYTES=5242880
LLC_WEB_MAX_REDIRECTS=4

# İsteğe bağlı yalnız-yerel OCR (Tesseract + pdftoppm gerekir).
LLC_OCR_ENABLED=0
LLC_OCR_COMMAND=tesseract

# Teknik mülakat kod soruları varsayılan olarak çalıştırılmaz. Yalnız yerel süreç için açıkça etkinleştirin.
LLC_CODE_RUNNER_ENABLED=0
LLC_CODE_RUNNER_TIMEOUT_SECONDS=5
LLC_CODE_RUNNER_MAX_OUTPUT_BYTES=65536
LLC_CODE_RUNNER_MAX_SOURCE_BYTES=131072

# Yerel embedding ve analiz önbellekleri için azami kayıt sayısı.
LLC_CACHE_MAX_ENTRIES=10000
